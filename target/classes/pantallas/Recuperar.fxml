<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="400.0" prefWidth="380" style="-fx-background-color: linear-gradient(to bottom, #1F5D3B, #0F3D2E);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uacm.puntodeventa.RecuperarController">

    <children>
        <VBox alignment="CENTER" prefHeight="436.0" prefWidth="380.0" spacing="20" style="-fx-background-color:#00502b; -fx-padding:40; -fx-background-radius:15;">

            <Label prefHeight="26.0" prefWidth="234.0" text="RECUPERAR CONTRASEÑA" textFill="WHITE">
                <font><Font name="Arial Bold" size="17.0" /></font>
            </Label>

            <Label text="Ingresa tu usuario para verificar tu identidad" textFill="WHITE" wrapText="true" />

            <VBox alignment="CENTER_LEFT" spacing="5">
                <Label text="Usuario" textFill="WHITE" />
                <TextField fx:id="txtUsuario" prefWidth="260" promptText="Ingresa tu usuario" style="-fx-background-radius:10; -fx-padding:10;" />
            </VBox>

            <Button onAction="#continuar" prefHeight="40" prefWidth="260" style="-fx-background-color:#146551; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:10;" text="CONTINUAR" />

            <Hyperlink onAction="#volverLogin" style="-fx-text-fill:#64B5F6;" text="Volver al inicio de sesión" />

        </VBox>
    </children>
</StackPane>
