<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="480.0" prefWidth="360.0" spacing="15" style="-fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 2;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uacm.puntodeventa.TicketController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <children>
        <Label style="-fx-font-weight: bold; -fx-text-fill: #2E7D32;" text="TICKET DE VENTA">
            <font>
                <Font name="Arial Bold" size="20.0" />
            </font>
        </Label>
        
        <TextArea fx:id="txtAreaTicket" editable="false" prefHeight="320.0" prefWidth="310.0" style="-fx-font-family: 'Courier New'; -fx-font-size: 13px; -fx-control-inner-background: white; -fx-background-color: transparent; -fx-border-color: #999999; -fx-border-style: dashed; -fx-border-width: 1px;" wrapText="false" />

        <Label style="-fx-text-fill: #555555; -fx-font-style: italic;" text="¡Gracias por su compra!">
            <font>
                <Font name="Arial" size="14.0" />
            </font>
        </Label>

        <Button fx:id="btnCerrar" prefHeight="34.0" prefWidth="157.0" style="-fx-background-color: #00502b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;" text="IMPRIMIR">
            <font>
                <Font name="Arial Bold" size="16.0" />
            </font>
        </Button>
    </children>
</VBox>