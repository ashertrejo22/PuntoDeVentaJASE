<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="520.0"
           prefWidth="500.0"
           style="-fx-background-color: linear-gradient(to bottom, #1F5D3B, #0F3D2E);"
           xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.uacm.puntodeventa.NuevaContraController">

    <children>

        <VBox alignment="CENTER"
              spacing="20"
              maxWidth="380"
              style="-fx-background-color:#00502b;
                     -fx-padding:35;
                     -fx-background-radius:20;">

            <Label text="NUEVA CONTRASEÑA"
                   textFill="WHITE">

                <font>
                    <Font name="Arial Bold" size="28"/>
                </font>

            </Label>

            <Label
                text="Usarás esta contraseña para iniciar sesión en tu cuenta. Crea una que tenga al menos 6 caracteres usando letras y números."
                wrapText="true"
                maxWidth="320"
                textFill="#d9f5ea"
                style="-fx-font-size:14px;
                       -fx-text-alignment:center;" />

            <PasswordField fx:id="txtNuevaContra"
                           promptText="Contraseña nueva"
                           prefWidth="320"
                           prefHeight="45"
                           style="-fx-background-radius:12;
                                  -fx-padding:10;
                                  -fx-font-size:14px;" />

            <PasswordField fx:id="txtConfirmarContra"
                           promptText="Introduce otra vez tu nueva contraseña"
                           prefWidth="320"
                           prefHeight="45"
                           style="-fx-background-radius:12;
                                  -fx-padding:10;
                                  -fx-font-size:14px;" />

            <Label fx:id="lblError"
                   textFill="#ffb3b3"
                   style="-fx-font-size:13px;
                          -fx-font-weight:bold;" />

            <Button text="Cambiar contraseña"
                    onAction="#guardarContra"
                    prefWidth="320"
                    prefHeight="48"
                    style="-fx-background-color:#146551;
                           -fx-text-fill:white;
                           -fx-font-size:16px;
                           -fx-font-weight:bold;
                           -fx-background-radius:12;
                           -fx-cursor:hand;" />

        </VBox>

    </children>
</StackPane>