<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="486.0" prefWidth="650.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uacm.puntodeventa.InventarioController">
   <children>
      <Pane prefHeight="86.0" prefWidth="649.0" style="-fx-background-color: #00502b;">
         <children>
            <Label layoutX="238.0" layoutY="22.0" text="Inventario" textFill="WHITE">
               <font>
                  <Font name="Arial Bold" size="36.0" />
               </font></Label>
         </children>
      </Pane>
      <TableView fx:id="tableViewProductos" layoutX="14.0" layoutY="152.0" prefHeight="305.0" prefWidth="623.0">
        <columns>
          <TableColumn fx:id="columnaide" prefWidth="60.0" text="ID" />
          <TableColumn fx:id="columnaNombre" prefWidth="190.0" text="Nombre" />
          
          <!-- NUEVA COLUMNA DE CATEGORÍA -->
          <TableColumn fx:id="colCategoria" prefWidth="105.0" text="Categoría" />
          
          <TableColumn fx:id="columnaStock" prefWidth="85.0" text="Stock" />
          <TableColumn fx:id="columnaPrecio" prefWidth="85.0" text="Precio" />
          <TableColumn fx:id="columnaTipo" prefWidth="97.0" text="Tipo" />
        </columns>
      </TableView>
      <TextField fx:id="txtFieldBuscar" layoutX="305.0" layoutY="102.0" prefHeight="26.0" prefWidth="246.0" promptText="Busqueda por nombre" />
      <Button fx:id="btnNuevo" layoutX="14.0" layoutY="102.0" mnemonicParsing="false" onAction="#click" prefHeight="25.0" prefWidth="76.0" style="-fx-background-color: #146551; -fx-background-radius: 25;" text="Nuevo" textFill="WHITE">
         <font>
            <Font name="Arial Bold" size="12.0" />
         </font>
      </Button>
      <Button fx:id="btnActualizar" layoutX="110.0" layoutY="102.0" mnemonicParsing="false" onAction="#actualizarProducto" prefHeight="25.0" prefWidth="76.0" style="-fx-background-color: #146551; -fx-background-radius: 25;" text="Actualizar" textFill="WHITE">
         <font>
            <Font name="Arial Bold" size="12.0" />
         </font>
      </Button>
      <Button fx:id="btnEliminar" layoutX="203.0" layoutY="102.0" mnemonicParsing="false" onAction="#eliminar" prefHeight="25.0" prefWidth="76.0" style="-fx-background-color: #146551; -fx-background-radius: 25;" text="Eliminar" textFill="WHITE">
         <font>
            <Font name="Arial Bold" size="12.0" />
         </font>
      </Button>
      <Label fx:id="lblInfo" layoutX="155.0" layoutY="464.0" text="Da doble click para ver la información del producto" textFill="#004bff">
         <font>
            <Font name="Arial Bold" size="14.0" />
         </font>
      </Label>
   </children>
</AnchorPane>