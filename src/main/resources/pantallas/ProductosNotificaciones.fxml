<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane
    id="AnchorPane"
    prefHeight="520.0"
    prefWidth="900.0"
    style="-fx-background-color: white;"
    xmlns="http://javafx.com/javafx/25"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="org.uacm.puntodeventa.ProductosNotificacionesController">

    <children>

        <Pane
            prefHeight="86.0"
            prefWidth="900.0"
            style="-fx-background-color: #00502b;">

            <children>

                <Label
                    layoutX="245.0"
                    layoutY="22.0"
                    text="Alertas y Reabastecimiento"
                    textFill="WHITE">

                    <font>
                        <Font name="Arial Bold" size="32.0"/>
                    </font>

                </Label>

            </children>

        </Pane>

        <Button
            fx:id="btnActuStock"
            layoutX="575.0"
            layoutY="106.0"
            mnemonicParsing="false"
            onAction="#actualizarStock"
            prefHeight="30.0"
            prefWidth="100.0"
            style="-fx-background-color: #146551; -fx-background-radius: 25;"
            text="Actualizar"
            textFill="WHITE">

            <font>
                <Font name="Arial Bold" size="12.0"/>
            </font>

        </Button>

        <Button
            fx:id="btnGenerarPedido"
            layoutX="685.0"
            layoutY="106.0"
            mnemonicParsing="false"
            onAction="#generarPedido"
            prefHeight="30.0"
            prefWidth="200.0"
            style="-fx-background-color: #146551; -fx-background-radius: 25;"
            text="Generar pedido automático"
            textFill="WHITE">

            <font>
                <Font name="Arial Bold" size="12.0"/>
            </font>

        </Button>

        <TableView
            fx:id="tableViewProductos"
            layoutX="61.0"
            layoutY="153.0"
            prefHeight="310.0"
            prefWidth="778.0">

            <columns>

                <TableColumn
                    fx:id="columnaId"
                    prefWidth="55.0"
                    text="ID"/>

                <TableColumn
                    fx:id="columnaNombre"
                    prefWidth="190.0"
                    text="Nombre"/>

                <TableColumn
                    fx:id="columnaStock"
                    prefWidth="75.0"
                    text="Stock"/>

                <TableColumn
                    fx:id="columnaMinimo"
                    prefWidth="90.0"
                    text="Mínimo"/>

                <TableColumn
                    fx:id="columnaProveedor"
                    prefWidth="150.0"
                    text="Proveedor"/>

                <TableColumn
                    fx:id="columnaCantidad"
                    prefWidth="100.0"
                    text="A pedir"/>

                <TableColumn
                    fx:id="columnaEstado"
                    prefWidth="120.0"
                    text="Estado"/>

            </columns>

        </TableView>

        <Label
            fx:id="lblInfo"
            layoutX="250.0"
            layoutY="479.0"
            text="Actualiza la lista para revisar el inventario"
            textFill="#004bff">

            <font>
                <Font name="Arial Bold" size="14.0"/>
            </font>

        </Label>

    </children>

</AnchorPane>
