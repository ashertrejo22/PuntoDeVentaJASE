<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="450.0" prefWidth="287.0" style="-fx-background-color: WHITE;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uacm.puntodeventa.TipoPagoController">
   <children>
      <!-- Encabezado alineado a la Pantalla Principal -->
      <Pane prefHeight="60.0" prefWidth="450.0" style="-fx-background-color: #00502b;">
         <children>
            <Label alignment="CENTER" layoutX="0.0" layoutY="16.0" prefHeight="27.0" prefWidth="450.0" text="FORMA DE PAGO" textFill="WHITE">
               <font>
                  <Font name="Arial Bold" size="24.0" />
               </font>
            </Label>
         </children>
      </Pane>

      <!-- Totales y Entradas -->
      <Label fx:id="lblTotal" layoutX="25.0" layoutY="80.0" text="Total a pagar $0.00 MXN">
         <font>
            <Font name="Arial Bold" size="18.0" />
         </font>
      </Label>
      <Label layoutX="25.0" layoutY="115.0" text="Monto a recibir en efectivo:">
         <font>
            <Font name="Arial Bold" size="14.0" />
         </font>
      </Label>
      
      <TextField fx:id="txtEfectivo" alignment="CENTER_RIGHT" editable="false" layoutX="25.0" layoutY="140.0" prefHeight="41.0" prefWidth="335.0" style="-fx-border-color: #00502b; -fx-border-width: 2; -fx-background-radius: 5; -fx-border-radius: 5;">
         <font>
            <Font name="Arial Bold" size="20.0" />
         </font>
      </TextField>

      <!-- Teclado Numérico y Botones de Acción -->
      <GridPane hgap="10.0" layoutX="25.0" layoutY="200.0" prefHeight="190.0" prefWidth="335.0" vgap="10.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <!-- Fila 1 -->
            <Button mnemonicParsing="false" onAction="#alPresionarNumero" prefHeight="50.0" prefWidth="70.0" style="-fx-background-color: WHITE; -fx-border-color: #146551; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;" text="7" textFill="#00502b">
               <font><Font name="Arial Bold" size="18.0" /></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#alPresionarNumero" prefHeight="50.0" prefWidth="70.0" style="-fx-background-color: WHITE; -fx-border-color: #146551; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;" text="8" textFill="#00502b" GridPane.columnIndex="1">
               <font><Font name="Arial Bold" size="18.0" /></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#alPresionarNumero" prefHeight="50.0" prefWidth="70.0" style="-fx-background-color: WHITE; -fx-border-color: #146551; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;" text="9" textFill="#00502b" GridPane.columnIndex="2">
               <font><Font name="Arial Bold" size="18.0" /></font>
            </Button>
            <!-- Botón Limpiar (Rojo JASE) -->
            <Button mnemonicParsing="false" onAction="#alPresionarLimpiar" prefHeight="50.0" prefWidth="80.0" style="-fx-background-color: #CF2E2B; -fx-background-radius: 15;" text="C" textFill="WHITE" GridPane.columnIndex="3">
               <font><Font name="Arial Bold" size="18.0" /></font>
            </Button>

            <!-- Fila 2 -->
            <Button mnemonicParsing="false" onAction="#alPresionarNumero" prefHeight="50.0" prefWidth="70.0" style="-fx-background-color: WHITE; -fx-border-color: #146551; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;" text="4" textFill="#00502b" GridPane.rowIndex="1">
               <font><Font name="Arial Bold" size="18.0" /></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#alPresionarNumero" prefHeight="50.0" prefWidth="70.0" style="-fx-background-color: WHITE; -fx-border-color: #146551; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;" text="5" textFill="#00502b" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <font><Font name="Arial Bold" size="18.0" /></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#alPresionarNumero" prefHeight="50.0" prefWidth="70.0" style="-fx-background-color: WHITE; -fx-border-color: #146551; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;" text="6" textFill="#00502b" GridPane.columnIndex="2" GridPane.rowIndex="1">
               <font><Font name="Arial Bold" size="18.0" /></font>
            </Button>
            <!-- Botón Cobrar Efectivo (Verde Brillante JASE) -->
            <Button mnemonicParsing="false" onAction="#alPresionarEnter" prefHeight="50.0" prefWidth="80.0" style="-fx-background-color: #35A03B; -fx-background-radius: 15;" text="ENTER" textFill="WHITE" GridPane.columnIndex="3" GridPane.rowIndex="1">
               <font><Font name="Arial Bold" size="13.0" /></font>
            </Button>

            <!-- Fila 3 -->
            <Button mnemonicParsing="false" onAction="#alPresionarNumero" prefHeight="50.0" prefWidth="70.0" style="-fx-background-color: WHITE; -fx-border-color: #146551; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;" text="1" textFill="#00502b" GridPane.rowIndex="2">
               <font><Font name="Arial Bold" size="18.0" /></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#alPresionarNumero" prefHeight="50.0" prefWidth="70.0" style="-fx-background-color: WHITE; -fx-border-color: #146551; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;" text="2" textFill="#00502b" GridPane.columnIndex="1" GridPane.rowIndex="2">
               <font><Font name="Arial Bold" size="18.0" /></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#alPresionarNumero" prefHeight="50.0" prefWidth="70.0" style="-fx-background-color: WHITE; -fx-border-color: #146551; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;" text="3" textFill="#00502b" GridPane.columnIndex="2" GridPane.rowIndex="2">
               <font><Font name="Arial Bold" size="18.0" /></font>
            </Button>
            <!-- Botón Débito (Verde Medio JASE) -->
            <Button mnemonicParsing="false" onAction="#alPresionarDebito" prefHeight="50.0" prefWidth="80.0" style="-fx-background-color: #146551; -fx-background-radius: 15;" text="Débito" textFill="WHITE" GridPane.columnIndex="3" GridPane.rowIndex="2">
               <font><Font name="Arial Bold" size="13.0" /></font>
            </Button>

            <!-- Fila 4 -->
            <Button mnemonicParsing="false" onAction="#alPresionarNumero" prefHeight="50.0" prefWidth="70.0" style="-fx-background-color: WHITE; -fx-border-color: #146551; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;" text="00" textFill="#00502b" GridPane.rowIndex="3">
               <font><Font name="Arial Bold" size="18.0" /></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#alPresionarNumero" prefHeight="50.0" prefWidth="70.0" style="-fx-background-color: WHITE; -fx-border-color: #146551; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;" text="0" textFill="#00502b" GridPane.columnIndex="1" GridPane.rowIndex="3">
               <font><Font name="Arial Bold" size="18.0" /></font>
            </Button>
            <Button mnemonicParsing="false" onAction="#alPresionarNumero" prefHeight="50.0" prefWidth="70.0" style="-fx-background-color: WHITE; -fx-border-color: #146551; -fx-border-width: 2; -fx-background-radius: 10; -fx-border-radius: 10;" text="." textFill="#00502b" GridPane.columnIndex="2" GridPane.rowIndex="3">
               <font><Font name="Arial Bold" size="18.0" /></font>
            </Button>
            <!-- Botón Crédito (Verde Medio JASE) -->
            <Button mnemonicParsing="false" onAction="#alPresionarCredito" prefHeight="50.0" prefWidth="80.0" style="-fx-background-color: #146551; -fx-background-radius: 15;" text="Crédito" textFill="WHITE" GridPane.columnIndex="3" GridPane.rowIndex="3">
               <font><Font name="Arial Bold" size="13.0" /></font>
            </Button>
         </children>
      </GridPane>

      <!-- Label de Cambio a dar (Resaltado) -->
      <Label fx:id="lblCambio" layoutX="25.0" layoutY="410.0" text="Cambio a dar $0.00 MXN" textFill="#cf2e2b">
         <font>
            <Font name="Arial Bold" size="18.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
